<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#FFFFFF</color>
    <string name="app_name">IGelik</string>
    <string name="battery_optimization_explanation">
        To ensure the virtual space continues running smoothly in the background, 
        please whitelist this app from battery optimization. This prevents the system 
        from stopping the virtual space when the app is in the background.
    </string>
    <string name="custom_url_scheme">com.igelik.app</string>
    <string name="package_name">com.igelik.app</string>
    <string name="title_activity_main">IGelik</string>
    <string name="virtual_space_active">Virtual Space Active</string>
    <string name="virtual_space_description">Running isolated apps and games in container</string>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>